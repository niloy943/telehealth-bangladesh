{
  "name": "telemedicine-backend",
  "version": "1.0.0",
  "description": "Secure E-Prescription Backend with AES-256-GCM, Blockchain Verification, and Automatic Security Lockdown",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --experimental-strip-types src/test-security-suite.ts",
    "test:e2e": "node --experimental-strip-types src/test-in-process-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "puppeteer": "^22.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
