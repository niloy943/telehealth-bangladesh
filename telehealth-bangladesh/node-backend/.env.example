# Server settings
PORT=5000
NODE_ENV=development

# Database connection: 'sqlite' or 'mysql'
DB_DIALECT=sqlite
DB_SQLITE_PATH=./src/config/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=telehealth_db

# Security Settings
JWT_SECRET=super_secret_jwt_signature_key_2026_swastho
JWT_EXPIRES_IN=1h

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock-username
SMTP_PASS=mock-password
SMTP_FROM=noreply@healnsight.com.bd

# Twilio SMS API Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
